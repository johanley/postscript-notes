%!PS-Adobe-3.0

% Example command line:
%  C:\ghostscript\gs10.08.0\bin\gswin64c.exe -dNOSAFER -sDEVICE=pdfwrite -o geometric-design.pdf geometric-design.ps

% Based on code found in a video by Orion Lawlor:
%   https://youtu.be/Tgy8S4dUVgY?t=2751

/page-width  612 def
/page-height 792 def 
<</PageSize [page-width  page-height]>> setpagedevice  
<< /NeverEmbed [ ] >> setdistillerparams  % always embed fonts
true setstrokeadjust  % minimizes off-by-one-pixel line issues

/pgsave save def     
/Times-Roman 15 selectfont

300 600 translate
0.2 setlinewidth

0 1 360 {
   /i exch def   % an angle
   
   i sin abs % cyan 
   i cos abs % magenta
   0.0 0.0 setcmykcolor
   
   /dist i cos 100 mul def
   gsave
     dist dist translate
     i rotate
     -150 -150 translate
     newpath
       100 100 moveto
       200 200 lineto
       200 100 lineto
       100 200 lineto
     closepath
     stroke
   grestore
} for
  
pgsave restore
showpage
