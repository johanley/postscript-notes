%!PS-Adobe-3.0

% USE TERRY BURTON'S EXCELLENT BAR CODE LIBRARY TO RENDER A BAR CODE.
% 
% The library can generate many different kinds of bar-code, including QR codes.
%     https://github.com/bwipp/postscriptbarcode/
%
% The library is downloaded and unzipped. 
% In order to use the library, you need to point Ghostscript to the library's directory
% using the -sGenericResourceDir switch on its command line.

% This works, but I get a Ghostscript warning! I don't know its cause:
%
%  *** Warning: GenericResourceDir doesn't point to a valid resource directory.
%               the -sGenericResourceDir=... option can be used to set this.

/page-width  8.5 72 mul def
/page-height 11 72 mul def % absolute values
<</PageSize [page-width  page-height]>> setpagedevice  
<< /NeverEmbed [ ] >> setdistillerparams  % always embed fonts
true setstrokeadjust  % minimizes off-by-one-pixel line issues

/pgsave save def     

  /Helvetica 15 selectfont

  % the library needs a currentpoint to exist
  100 650 moveto 

  % call the library to mark an ISBN code
  (978-1-86074-271 54495) (includetext) /isbn /uk.co.terryburton.bwipp findresource exec

  % Controlling the size of the generated bar code:
  % https://github.com/bwipp/postscriptbarcode/wiki/Resizing-Symbols

  % options: https://github.com/bwipp/postscriptbarcode/wiki/ISBN

pgsave restore
showpage
